{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://onchainoncall.com/schemas/oasg.policy.v1.json",
  "title": "Open Agent Spend Guard Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "version", "rules"],
  "properties": {
    "schemaVersion": { "const": "oasg.policy.v1" },
    "policyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedChains", "assets"],
      "properties": {
        "allowedChains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/chainId" }
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/assetRule" }
        },
        "allowedCounterparties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "allowedPurposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" }
        }
      }
    }
  },
  "definitions": {
    "atomicAmount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 78 },
    "chainId": { "type": "string", "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$" },
    "assetId": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}/[-a-z0-9]{3,8}:[-._%a-zA-Z0-9]{1,128}$"
    },
    "assetRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "maxPerTransaction"],
      "properties": {
        "assetId": { "$ref": "#/definitions/assetId" },
        "maxPerTransaction": { "$ref": "#/definitions/atomicAmount" },
        "approvalRequiredAbove": { "$ref": "#/definitions/atomicAmount" },
        "periodBudget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["period", "limit"],
          "properties": {
            "period": { "const": "day" },
            "limit": { "$ref": "#/definitions/atomicAmount" }
          }
        }
      }
    }
  }
}
